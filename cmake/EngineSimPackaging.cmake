set(CPACK_PACKAGE_NAME "open-engine-simulator")
set(CPACK_PACKAGE_VENDOR "Open Engine Simulator contributors")
set(CPACK_PACKAGE_CONTACT "Open Engine Simulator contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY
    "Portable SDL desktop fork of AngeTheGreat's Engine Simulator")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "Open Engine Simulator")
set(CPACK_PACKAGE_FILE_NAME
    "open-engine-simulator-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_MONOLITHIC_INSTALL ON)
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
if(APPLE)
    set(CPACK_GENERATOR "DragNDrop;ZIP")
    set(CPACK_DMG_VOLUME_NAME "Open Engine Simulator")
elseif(WIN32)
    set(CPACK_GENERATOR "NSIS;ZIP")
    set(CPACK_NSIS_DISPLAY_NAME "Open Engine Simulator")
    set(CPACK_NSIS_PACKAGE_NAME "Open Engine Simulator")
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
    set(CPACK_NSIS_MODIFY_PATH OFF)
    set(CPACK_PACKAGE_EXECUTABLES "engine-sim-desktop" "Open Engine Simulator")
    set(CPACK_CREATE_DESKTOP_LINKS "engine-sim-desktop")
elseif(UNIX)
    set(CPACK_GENERATOR "DEB;TGZ")
    set(CPACK_DEBIAN_PACKAGE_NAME "open-engine-simulator")
    set(CPACK_DEBIAN_PACKAGE_SECTION "games")
endif()
include(CPack)
